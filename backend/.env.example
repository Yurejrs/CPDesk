# Use um segredo exclusivo em produção; sem variável, a chave fica em data/session.key.
CPDESK_SECRET_KEY=
CPDESK_DATABASE_URL=sqlite:///./data/cpdesk.db
CPDESK_CORS_ORIGINS=http://localhost:5173
# Opcional para bootstrap automatizado inicial; mantenha fora de scripts versionados.
CPDESK_ADMIN_USERNAME=
CPDESK_ADMIN_PASSWORD=
